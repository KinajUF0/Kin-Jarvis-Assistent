# Kin / Jarvis — настройки

# === OLLAMA (рекомендуется, работает в РФ) ===
AI_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# Установка: scripts\install_ollama.bat
# Или: ollama.com → ollama pull llama3.2

# === GEMINI (опционально, нестабилен в РФ) ===
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# === Голос ===
SPEECH_LANGUAGE=ru-RU
TTS_VOICE=ru-RU-DmitryNeural
ASSISTANT_NAME=Кин

DISCORD_PATH=
LOG_LEVEL=INFO
