# ============================================
# Kin / Jarvis Assistant — Configuration
# ============================================
# Скопируйте этот файл как .env и заполните значения:
#   copy .env.example .env   (Windows)
#   cp .env.example .env     (Linux/macOS)

# Google Gemini API Key (обязательно)
# Получить: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Модель Gemini (рекомендуется gemini-2.0-flash)
GEMINI_MODEL=gemini-2.5-flash-lite

# Язык распознавания речи (ru-RU или en-US)
SPEECH_LANGUAGE=ru-RU

# Голос TTS (ru-RU-DmitryNeural, ru-RU-SvetlanaNeural, en-US-GuyNeural)
TTS_VOICE=ru-RU-DmitryNeural

# Имя ассистента по умолчанию для ответов
ASSISTANT_NAME=Кин

# Путь к Discord (Windows, оставьте пустым для авто-поиска)
DISCORD_PATH=

# Уровень логирования (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
