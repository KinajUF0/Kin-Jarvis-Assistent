{
  "apps": {
    "browser": {
      "display_name": "Браузер (по умолчанию)",
      "process_names": ["msedge", "chrome", "firefox", "brave", "opera"],
      "paths": [],
      "auto_detect": true,
      "notes": "Автоматически определяет Edge, Chrome, Firefox и др."
    },
    "edge": {
      "display_name": "Microsoft Edge",
      "process_names": ["msedge"],
      "paths": [
        "C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe",
        "C:\\Program Files\\Microsoft\\Edge\\Application\\msedge.exe",
        "msedge"
      ]
    },
    "chrome": {
      "display_name": "Google Chrome",
      "process_names": ["chrome"],
      "paths": [
        "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe",
        "C:\\Program Files (x86)\\Google\\Chrome\\Application\\chrome.exe",
        "google-chrome"
      ]
    },
    "firefox": {
      "display_name": "Mozilla Firefox",
      "process_names": ["firefox"],
      "paths": [
        "C:\\Program Files\\Mozilla Firefox\\firefox.exe",
        "firefox"
      ]
    },
    "brave": {
      "display_name": "Brave",
      "process_names": ["brave"],
      "paths": [
        "C:\\Program Files\\BraveSoftware\\Brave-Browser\\Application\\brave.exe",
        "%LOCALAPPDATA%\\BraveSoftware\\Brave-Browser\\Application\\brave.exe"
      ]
    },
    "opera": {
      "display_name": "Opera",
      "process_names": ["opera"],
      "paths": ["%LOCALAPPDATA%\\Programs\\Opera\\opera.exe"]
    },
    "yandex": {
      "display_name": "Yandex Browser",
      "process_names": ["browser"],
      "paths": ["%LOCALAPPDATA%\\Yandex\\YandexBrowser\\Application\\browser.exe"]
    },
    "discord": {
      "display_name": "Discord",
      "process_names": ["discord", "Discord"],
      "paths": [
        "%LOCALAPPDATA%\\Discord\\Update.exe --processStart Discord.exe",
        "%LOCALAPPDATA%\\Discord\\app-1.0.9159\\Discord.exe"
      ],
      "uri": "discord://"
    },
    "steam": {
      "display_name": "Steam",
      "process_names": ["steam"],
      "paths": ["C:\\Program Files (x86)\\Steam\\steam.exe", "steam"],
      "uri": "steam://"
    },
    "spotify": {
      "display_name": "Spotify",
      "process_names": ["spotify"],
      "paths": ["%APPDATA%\\Spotify\\Spotify.exe", "spotify"],
      "uri": "spotify:"
    },
    "telegram": {
      "display_name": "Telegram",
      "process_names": ["telegram"],
      "paths": ["%APPDATA%\\Telegram Desktop\\Telegram.exe", "telegram-desktop"]
    },
    "vscode": {
      "display_name": "Visual Studio Code",
      "process_names": ["code"],
      "paths": ["code", "%LOCALAPPDATA%\\Programs\\Microsoft VS Code\\Code.exe"]
    },
    "notepad": {
      "display_name": "Блокнот",
      "process_names": ["notepad"],
      "paths": ["notepad"]
    },
    "explorer": {
      "display_name": "Проводник",
      "process_names": ["explorer"],
      "paths": ["explorer"]
    },
    "calculator": {
      "display_name": "Калькулятор",
      "process_names": ["calculator", "calc"],
      "paths": ["calc"]
    }
  }
}
